APP_NAME="School Management System"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=school_management
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- M-Pesa Daraja (STK Push) ---
# Get sandbox credentials free at https://developer.safaricom.co.ke (create an app under "My Apps")
# Leave MPESA_ENV=sandbox until you have production Paybill/Till credentials from Safaricom.
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919
MPESA_CALLBACK_URL=https://your-public-url.example.com/mpesa/callback

# --- Africa's Talking (Bulk SMS) ---
# Sign up free at https://africastalking.com — sandbox app works immediately with username "sandbox"
# and a sandbox API key; switch AT_ENV to production once you have a paid account + live API key.
AT_ENV=sandbox
AT_USERNAME=sandbox
AT_API_KEY=
AT_SENDER_ID=
